{
  "manifest_version": 3,
  "name": "CORRUPTION",
  "version": "0.8.0",
  "description": "If the signal is corrupting us, we take back power by corrupting the signal. An installation piece by John Holmes.",
  "permissions": ["storage", "declarativeNetRequest", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/bootstrap.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cors-media",
        "enabled": true,
        "path": "rules/cors-media.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["content/*.js", "gl/*.js", "gl/shaders/*.js", "audio/*.js", "panel/panel.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "CORRUPTION — click to play, Ctrl+Shift+D on/off"
  },
  "commands": {
    "toggle-effect": {
      "suggested_key": { "default": "Ctrl+Shift+D" },
      "description": "Toggle the effect on/off"
    },
    "open-panel": {
      "suggested_key": { "default": "Ctrl+Shift+P" },
      "description": "Open the control panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
